rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contacts/{document} {
      allow write: if true;  // Allows anyone to write to contacts collection
      allow read: if false;  // Prevents unauthorized reading of contact submissions
    }
    match /newsletter_subscribers/{document} {
      allow write: if true;  // Allows anyone to subscribe to newsletter
      allow read: if false;  // Prevents unauthorized reading of subscriber list
    }
  }
}